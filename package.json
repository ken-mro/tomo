{
  "name": "tomo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.2",
  "description": "tomo — a Pomodoro timer with a cute tomato focus friend and a floating Picture-in-Picture window.",
  "type": "module",
  "scripts": {
    "gen:sounds": "node scripts/gen-sounds.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:assets": "node scripts/gen-sounds.mjs && node scripts/gen-icons.mjs",
    "predev": "pnpm gen:assets",
    "prebuild": "pnpm gen:assets",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.34.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
